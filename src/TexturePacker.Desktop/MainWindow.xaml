<Window x:Class="TexturePacker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TexturePacker.Desktop.ViewModels"
        xmlns:controls="clr-namespace:TexturePacker.Desktop.Controls"
        Title="Texture Packer Pro" Icon="Assets/App.png" ThemeMode="Dark"
        Width="1380" Height="900" MinWidth="800" MinHeight="600"
        Background="Transparent" Foreground="#EEF0F7" FontFamily="Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ProcessCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <controls:LayoutValueConverter x:Key="LayoutValue" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#9BA9EF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#ADB9FF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#7484DC" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#9BA9EF" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#182037" />
    <Style x:Key="OverlayScroller" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Width="8" HorizontalAlignment="Right" Margin="0,2,4,2" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModeTab" TargetType="ListBoxItem">
      <Setter Property="Grid.Column" Value="{Binding Mode, Converter={StaticResource LayoutValue}, ConverterParameter=column}" />
      <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1" Padding="3,5">
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#14FFFFFF" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#40798DE2" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="#306E7DE4" /></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlatTextButton" TargetType="Button">
      <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="FlatBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FlatBorder" Property="Opacity" Value="0.8" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FlatBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="FlatBorder" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChannelToggle" TargetType="ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="11" />
      <Setter Property="Height" Value="34" /><Setter Property="MinWidth" Value="0" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Background" Value="#08FFFFFF" /><Setter Property="BorderBrush" Value="#16FFFFFF" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Padding="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" /><Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" /><Setter Property="Background" Value="#12FFFFFF" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#18FFFFFF" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type vm:SlotViewModel}">
      <Border x:Name="SourceCard" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16" AllowDrop="True" Drop="Slot_Drop" DragOver="Window_DragOver">
        <StackPanel>
          <Grid Height="20" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
              <Border Width="20" Height="20" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0"><TextBlock Text="{Binding Id, Converter={StaticResource LayoutValue}, ConverterParameter=badge}" Foreground="{Binding AccentBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="REMOVE" Style="{StaticResource FlatTextButton}" Foreground="#EDA1A7" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Right" Command="{Binding RemoveCommand}" Visibility="{Binding HasFile, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Remove texture" />
          </Grid>
          <Button x:Name="SourceWell" Command="{Binding BrowseCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource LayoutValue}, ConverterParameter=half}" ToolTip="{Binding FilePath}" AutomationProperties.Name="Choose source texture">
            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="WellBorder" Background="{StaticResource WellBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="WellBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="WellBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            <Grid>
              <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasFile}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="+" FontSize="25" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" /><TextBlock Text="SELECT FILE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
              <TextBlock Text="Loading…" Background="#B0202127" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" />
            </Grid>
          </Button>
          <Grid Height="20" Margin="4,8,4,0">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasFile}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <TextBlock Text="FILL" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Width="16" Height="16" Command="{Binding BlackCommand}" Margin="0,0,5,0" ToolTip="Fill with black (0)" AutomationProperties.Name="Black fill"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FlatTextButton}"><Setter Property="Background" Value="#FF15151A" /><Setter Property="BorderBrush" Value="#50FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding FillWhite}" Value="False"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Width="16" Height="16" Command="{Binding WhiteCommand}" ToolTip="Fill with white (255)" AutomationProperties.Name="White fill"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FlatTextButton}"><Setter Property="Background" Value="#FFF7F7FA" /><Setter Property="BorderBrush" Value="#50FFFFFF" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding FillWhite}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="WorkspaceRoot" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" Background="#CF6E7DE4" CornerRadius="4" Margin="0,0,12,0"><TextBlock Text="TX" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock FontSize="18" VerticalAlignment="Center"><Run Text="Texture Packer " FontWeight="SemiBold" /><Run Text="Pro" Foreground="{StaticResource MutedBrush}" /></TextBlock></StackPanel>
        <TextBlock Text="HIGH BIT-DEPTH UTILITY" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer x:Name="SourceScroll" Style="{StaticResource OverlayScroller}" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24">
            <Border x:Name="ModeStrip" Height="52" Background="#08FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,24">
              <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" ItemContainerStyle="{StaticResource ModeTab}" BorderThickness="0" Padding="0" Background="Transparent" IsEnabled="{Binding CanEdit}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><Grid IsItemsHost="True"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions></Grid></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Mode, Converter={StaticResource LayoutValue}}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <StackPanel Visibility="{Binding IsAtlasMode, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}">
              <TextBlock Text="GRID SIZE" Height="16" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
              <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="COLUMNS" Height="15" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" /><TextBox x:Name="AtlasColumnsBox" Text="{Binding AtlasColumns, UpdateSourceTrigger=Explicit}" Tag="columns" Height="38" FontSize="14" Padding="10,8" LostFocus="AtlasValue_Commit" KeyDown="AtlasValue_KeyDown" AutomationProperties.Name="Atlas columns" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ROWS" Height="15" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" /><TextBox x:Name="AtlasRowsBox" Text="{Binding AtlasRows, UpdateSourceTrigger=Explicit}" Tag="rows" Height="38" FontSize="14" Padding="10,8" LostFocus="AtlasValue_Commit" KeyDown="AtlasValue_KeyDown" AutomationProperties.Name="Atlas rows" /></StackPanel></Grid>
              <UniformGrid Columns="4"><Button x:Name="Grid2x2" Content="2x2" Height="29" MinHeight="0" FontSize="10" Margin="0,0,8,0" HorizontalAlignment="Stretch" Tag="2,2" Click="AtlasPreset_Click" /><Button x:Name="Grid3x3" Content="3x3" Height="29" MinHeight="0" FontSize="10" Margin="0,0,8,0" HorizontalAlignment="Stretch" Tag="3,3" Click="AtlasPreset_Click" /><Button x:Name="Grid4x4" Content="4x4" Height="29" MinHeight="0" FontSize="10" Margin="0,0,8,0" HorizontalAlignment="Stretch" Tag="4,4" Click="AtlasPreset_Click" /><Button x:Name="Grid2x3" Content="2x3" Height="29" MinHeight="0" FontSize="10" HorizontalAlignment="Stretch" Tag="2,3" Click="AtlasPreset_Click" /></UniformGrid>
              <Border Height="73" Background="#126E7DE4" BorderBrush="#346E7DE4" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,24,0,24"><TextBlock Text="Drag and drop textures directly onto the grid cells in the viewport to the right." FontSize="12" Foreground="#BEC7FF" TextWrapping="Wrap" LineHeight="18" /></Border>
              <Button Content="Clear All Slots" Command="{Binding ClearCommand}" HorizontalAlignment="Stretch" Height="34" FontSize="12" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsInvertMode, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanEdit}">
              <TextBlock Text="PRESETS" Height="16" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="8" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                <Button x:Name="RoughPreset" Command="{Binding InvertPresetCommand}" CommandParameter="rgb" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel><TextBlock Text="Gloss ⇄ Rough" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="RGB Invert (1 - x)" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Button>
                <Button x:Name="GreenPreset" Grid.Column="2" Command="{Binding InvertPresetCommand}" CommandParameter="green" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel><TextBlock Text="Flip Normal Y" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="DirectX ⇄ OpenGL (G)" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Button>
                <Button x:Name="AlphaPreset" Grid.Row="2" Command="{Binding InvertPresetCommand}" CommandParameter="alpha" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel><TextBlock Text="Invert Alpha" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Alpha Mask (1 - A)" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Button>
                <Button x:Name="AllPreset" Grid.Row="2" Grid.Column="2" Command="{Binding InvertPresetCommand}" CommandParameter="all" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel><TextBlock Text="Invert All" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Full RGBA Inversion" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Button>
              </Grid>
              <Grid Height="16" Margin="0,20,0,8"><TextBlock Text="CHANNELS TO INVERT" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="255 - X" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" /></Grid>
              <UniformGrid Columns="4"><ToggleButton Content="● Red" Tag="#EDA1A7" Style="{StaticResource ChannelToggle}" IsChecked="{Binding InvertR}" /><ToggleButton Content="● Green" Tag="#9DCBB0" Style="{StaticResource ChannelToggle}" IsChecked="{Binding InvertG}" /><ToggleButton Content="● Blue" Tag="#A0B9F0" Style="{StaticResource ChannelToggle}" IsChecked="{Binding InvertB}" /><ToggleButton Content="● Alpha" Tag="#D3D6E0" Style="{StaticResource ChannelToggle}" IsChecked="{Binding InvertA}" Margin="0" /></UniformGrid>
              <Border Height="104" Background="#0EEDA958" BorderBrush="#32EDA958" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,20,0,20"><TextBlock Text="Inverts pixel values using 255 - Value (One-Minus). Perfect for converting Glossiness to Roughness, Smoothness to Roughness, or flipping DirectX/OpenGL Normal map Y green channel." FontSize="12" Foreground="#D6C3A8" TextWrapping="Wrap" LineHeight="18" /></Border>
            </StackPanel>
            <ItemsControl x:Name="SourceCards" ItemsSource="{Binding Slots}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsAtlasMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style></ItemsControl>
            <Button x:Name="ProcessButton" Command="{Binding ProcessCommand}" Content="{Binding SelectedMode.Mode, Converter={StaticResource LayoutValue}, ConverterParameter=action}" Height="48" HorizontalAlignment="Stretch" FontSize="12" FontWeight="SemiBold" Background="#DA6E7DE4" BorderBrush="#446E7DE4" ToolTip="Ctrl+Enter"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,16,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsAtlasMode}" Value="True"><Setter Property="Margin" Value="0,32,0,0" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#88C5AA" Margin="0,0,8,0" /><TextBlock Text="VIEWPORT 1.0" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource MutedBrush}" ToolTip="{Binding Status}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding ResultInfo, Converter={StaticResource LayoutValue}, ConverterParameter=dimensions}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0" /><Button Content="DOWNLOAD OUTPUT" Command="{Binding SaveCommand}" Height="28" MinHeight="0" FontSize="10" FontWeight="SemiBold" Background="#2788C5AA" BorderBrush="#4088C5AA" Padding="16,4" ToolTip="Ctrl+S" /></StackPanel></Grid></Border>
        <Grid x:Name="ViewportArea" Grid.Row="1" Background="Transparent" SizeChanged="PreviewScroll_SizeChanged">
          <Grid.ContextMenu><ContextMenu><MenuItem Header="Fit preview" Tag="fit" Click="PreviewZoom_Click" /><MenuItem Header="100%" Tag="1" Click="PreviewZoom_Click" /><MenuItem Header="200%" Tag="2" Click="PreviewZoom_Click" /><MenuItem Header="400%" Tag="4" Click="PreviewZoom_Click" /></ContextMenu></Grid.ContextMenu>
          <ScrollViewer x:Name="PreviewScroll" Padding="48" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Visibility="{Binding HasViewportTexture, Converter={StaticResource BoolVisibility}}">
            <Border x:Name="ImageCanvas" Background="{StaticResource CheckerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid><Image x:Name="OutputImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{Binding Preview}" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsInvertMode}" Value="True" /><Condition Binding="{Binding HasResult}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Source" Value="{Binding SourcePreview}" /></MultiDataTrigger></Style.Triggers></Style></Image.Style></Image><Border Background="#C5202127" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,6" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsInvertMode}" Value="True" /><Condition Binding="{Binding HasResult}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="SOURCE TEXTURE (CLICK PROCESS TO INVERT)" Foreground="#D6C3A8" FontSize="10" FontWeight="SemiBold" /></Border></Grid>
            </Border>
          </ScrollViewer>
          <Border x:Name="AtlasCanvas" Background="#30000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAtlasMode}" Value="True" /><Condition Binding="{Binding HasResult}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
            <ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding AtlasColumns}" Rows="{Binding AtlasRows}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid AllowDrop="True" Drop="Slot_Drop" DragOver="Window_DragOver"><Button Command="{Binding BrowseCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{StaticResource FlatTextButton}" BorderBrush="#0AFFFFFF" BorderThickness="1" ToolTip="{Binding Label}"><Grid><Image Source="{Binding Preview}" Stretch="UniformToFill" /><TextBlock Text="{Binding Id, Converter={StaticResource LayoutValue}, ConverterParameter=tile}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasFile}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Button><Button Content="×" Command="{Binding RemoveCommand}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" FontSize="12" Visibility="{Binding HasFile, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Remove atlas texture" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Border>
          <Border x:Name="EmptyCanvas" Width="322" Height="322" Background="{StaticResource CheckerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasViewportTexture}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsAtlasMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="48" Foreground="{StaticResource MutedBrush}" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,16" /><TextBlock Text="EMPTY WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Opacity="0.6" /></StackPanel></Border>
          <Border Background="#CE452E35" BorderBrush="#706C4752" BorderThickness="1" CornerRadius="8" Padding="16,12" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="600" Margin="24" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ErrorMessage}" Foreground="#F3BBC5" TextWrapping="Wrap" /><Button Grid.Column="1" Content="×" Command="{Binding DismissErrorCommand}" Margin="12,0,0,0" Width="24" Height="24" Padding="0" /></Grid></Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
